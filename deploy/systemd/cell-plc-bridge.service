[Unit]
Description=cell-runtime: Modbus TCP to ZeroMQ bridge
Documentation=https://github.com/youssefehaab/Cell-runtime
PartOf=cell.target
# Ordering only: the bridge reconnects with backoff, so it must not fail if the PLC is down.
After=network.target cell-plc-sim.service
Wants=cell-plc-sim.service
# Give up (and surface the failure) instead of restart-looping forever.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
User=cell
Group=cell
Environment=CELL_CONFIG_DIR=/opt/cell-runtime/current/etc/cell-runtime
ExecStart=/opt/cell-runtime/current/bin/plc_bridge
Restart=on-failure
RestartSec=1
# The main loop calls sd_notify(WATCHDOG=1); a stalled loop is killed and restarted.
WatchdogSec=5
NotifyAccess=main
TimeoutStopSec=5
# ipc:// sockets live in /tmp/cell, shared by every unit of the cell. Created as
# root ("+") before the sandbox below is set up for the main process.
ExecStartPre=+/usr/bin/install -d -o cell -g cell -m 0750 /tmp/cell
# Hardening: the services need no privileges at all.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/tmp/cell
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=cell.target
